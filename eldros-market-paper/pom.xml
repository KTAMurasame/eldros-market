<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.eldros</groupId>
    <artifactId>eldros-market</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>eldros-market-paper</artifactId>
  <name>Eldros Market (Paper plugin)</name>

  <properties>
    <!-- Lowest supported API (D1). A separate check covers newer APIs (docs/03 §10.2). -->
    <paper.version>1.21.4-R0.1-SNAPSHOT</paper.version>
    <!-- plugin.yml libraries: fallback only; the server's own driver is used when present (D10). -->
    <sqlite.fallback.version>3.47.0.0</sqlite.fallback.version>
    <!-- Release jars drop the crash-test tooling; the crashtest profile overrides this. -->
    <debug.exclude>com/eldros/market/paper/debug/**</debug.exclude>
  </properties>

  <repositories>
    <repository>
      <id>papermc</id>
      <url>https://repo.papermc.io/repository/maven-public/</url>
    </repository>
    <repository>
      <id>jitpack</id>
      <url>https://jitpack.io</url>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>com.eldros</groupId>
      <artifactId>eldros-market-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.papermc.paper</groupId>
      <artifactId>paper-api</artifactId>
      <version>${paper.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.github.MilkBowl</groupId>
      <artifactId>VaultAPI</artifactId>
      <version>1.7</version>
      <scope>provided</scope>
      <exclusions>
        <exclusion>
          <groupId>org.bukkit</groupId>
          <artifactId>bukkit</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>

  <build>
    <finalName>EldrosMarket-${project.version}</finalName>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>plugin.yml</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>plugin.yml</exclude>
        </excludes>
      </resource>
      <!-- GPL-3.0 text travels with every jar. -->
      <resource>
        <directory>${project.basedir}/..</directory>
        <targetPath>META-INF</targetPath>
        <includes>
          <include>LICENSE</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <!-- Only our own modules go into the jar; Paper, Vault and SQLite come from the server. -->
              <artifactSet>
                <includes>
                  <include>com.eldros:*</include>
                </includes>
              </artifactSet>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <!-- Crash-test tooling (docs/04 §3.8) never ships: only the crashtest profile keeps it. -->
              <filters>
                <filter>
                  <artifact>com.eldros:eldros-market-paper</artifact>
                  <excludes>
                    <exclude>${debug.exclude}</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Test build with the crash-point tooling: mvn -Pcrashtest package (never publish this jar). -->
    <profile>
      <id>crashtest</id>
      <properties>
        <debug.exclude>nothing-excluded/**</debug.exclude>
      </properties>
    </profile>
    <!-- Compile-only check against the newest API (docs/03 §10.2). Run with JDK 25: mvn -Pcompat-26 compile -->
    <profile>
      <id>compat-26</id>
      <properties>
        <paper.version>26.3.build.253-stable</paper.version>
      </properties>
    </profile>
  </profiles>
</project>
