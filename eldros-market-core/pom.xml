<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.eldros</groupId>
    <artifactId>eldros-market</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>eldros-market-core</artifactId>
  <name>Eldros Market Core</name>

  <properties>
    <sqlite.test.version>3.47.0.0</sqlite.test.version>
  </properties>
  <description>Market logic (money, order book, matching). Must stay free of Bukkit/Paper. See docs/03 §2.</description>

  <dependencies>
    <dependency>
      <groupId>com.eldros</groupId>
      <artifactId>eldros-market-api</artifactId>
    </dependency>

    <!-- At runtime the server's own sqlite-jdbc is used (D10). Tests run against the oldest one seen on a
         supported server by default; F2 also runs with -Dsqlite.test.version=3.49.1.0 (docs/F2 plan §4). -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>${sqlite.test.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>net.jqwik</groupId>
      <artifactId>jqwik</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-core-is-server-free</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>org.bukkit</exclude>
                    <exclude>org.spigotmc</exclude>
                    <exclude>io.papermc*</exclude>
                    <exclude>net.kyori</exclude>
                    <exclude>com.github.MilkBowl</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
